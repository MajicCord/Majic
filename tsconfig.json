{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@api/*": ["src/renderer/api/*"],
      "@webpack": ["src/renderer/webpack/index.ts"],
      "@webpack/common": ["src/renderer/webpack/common.ts"],
      "@utils/*": ["src/renderer/utils/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["src", "scripts"]
}
